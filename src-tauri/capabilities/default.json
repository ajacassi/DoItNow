{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://*.githubusercontent.com/*" },
        { "url": "https://uploads.github.com/*" }
      ]
    }
  ]
}
